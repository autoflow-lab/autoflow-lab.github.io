<script src="/fully-home/lib/easing/easing.min.js"></script>
<script src="/fully-home/lib/counterup/jquery.waypoints.min.js"></script>
<script src="/fully-home/lib/counterup/jquery.counterup.js"></script>
<script src="/fully-home/lib/typed/typed.min.js"></script>
<script src="/fully-home/lib/toaster/toaster.js"></script>

<script>
(function ($) {
// Use scrolling to the anchor links	
$('a[href^="#"]').addClass('js-scroll');
})(jQuery);

window.addEventListener("keydown", (e) => {
  if (e.code === 'F3' || ((e.ctrlKey || e.metaKey) && e.code === 'KeyF')) { 
    e.preventDefault();
    $('#query').focus();
	$('#query').select();
  }
})
	
window.addEventListener("keydown", (e) => {
  if (((e.ctrlKey || e.metaKey) && e.code === 'KeyG')) { 
    e.preventDefault();
	if (strToFind != null)
		findString(strToFind);
  }
})	
	
var TRange=null;
var strToFind=null;	

function findString (str) {
 if (parseInt(navigator.appVersion)<4) return;
 var strFound;
 strToFind = str;
 if (window.find) {

  // console.log("Searching for " + str);
	 
  // NB: Adding more params causes FF exception here
  strFound=self.find(str,false,false,true,false);
	 
  // Rewind back to the first result
  if (!strFound) {
   strFound=self.find(str,false,true,true,false);
   while (self.find(str,false,true,true,false)) continue;
  }
	
  if (/Firefox/.test(navigator.userAgent))
    nextResultHint = 'Press Ctrl+G for the next result';
  else
	nextResultHint = 'Press Enter or Ctrl+G for the next result';
	  
  Toaster.toast(nextResultHint, {
    color: '#444444',
    autoClose: true,
    autoCloseDelay: 2000,
	position: 'right-bottom'
  });
 }
 else if (navigator.appName.indexOf("Microsoft")!=-1) {

  if (TRange!=null) {
   TRange.collapse(false);
   strFound=TRange.findText(str);
   if (strFound) TRange.select();
  }
  if (TRange==null || strFound==0) {
   TRange=self.document.body.createTextRange();
   strFound=TRange.findText(str);
   if (strFound) TRange.select();
  }
 }
 else if (navigator.appName=="Opera") {
  alert ("Opera browsers not supported, sorry...")
  return;
 }
 if (!strFound) 
  Toaster.toast("String '"+str+"' not found!", {
    color: '#444444',
    autoClose: true,
    autoCloseDelay: 2000,
	position: 'right-bottom'
  });	 
	 
 return;
}

// Don't translate settings names
$('li').contents().filter(function() {
    return this.nodeType === 3;
}).each(function() {
    var escaped = $('<div></div>').text($(this).text()).html();
    escaped = escaped.replace(/(.*?) –/g, '<span class="notranslate"> $1 </span>  –');
	$(this).replaceWith(escaped);
});	
	
// Don't translate brand and special words
$('body, body *:not(a.su-button span,button,textarea,input,option,pre,span.notranslate)').contents().filter(function() {
    return this.nodeType === 3;
}).each(function() {
    var escaped = $('<div></div>').text($(this).text()).html();
	escaped = escaped.replace(/(Fully[ ]?(Kiosk[ ]?(Browser)?|Cloud|Video Kiosk|Single App Kiosk|Exam Kiosk|Provisioner)?)/g, ' <span class="notranslate">$1</span> ');
	escaped = escaped.replace(/((Fully )?PLUS)/g, ' <span class="notranslate">$1</span> ');
		escaped = escaped.replace(/((Android )?Webview)/gi, ' <span class="notranslate">$1</span> ');
    escaped = escaped.replace(/((Device )?Provisioning)/gi, ' <span class="notranslate">$1</span> ');
	escaped = escaped.replace(/((Android )?Enterprise[s]?)/gi, ' <span class="notranslate">$1</span> ');
	escaped = escaped.replace(/((Universal )?Launcher)/gi, ' <span class="notranslate">$1</span> ');
	escaped = escaped.replace(/(Deployment)/gi, ' <span class="notranslate"> $1</span> ');
	$(this).replaceWith(escaped);
});

// Don't translate some tags
$("pre").addClass("notranslate");

// Auto-translate according to lang query parameter
document.addEventListener("DOMContentLoaded", function() {
	const params = new URLSearchParams(window.location.search);
    const lang = params.get('lang');
    if (lang) {
    if(!window.gt_translate_script) {
        window.gt_translate_script = document.createElement('script');
        gt_translate_script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit2';
        document.body.appendChild(gt_translate_script);
    }

        doGTranslate('en|'+lang);
    }
});
	
</script>

